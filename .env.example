# Copy to .env and fill in. These are read by the Vite dev/preview server only;
# they are never bundled into the browser code.

# Your TypeSafe API key (https://console.typesafe.ai -> API Keys)
TYPESAFE_API_KEY=

# Base URL of any server that implements POST /v1/systemone (TypeSafe or compatible)
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Model preselected in the playground
DEFAULT_MODEL=jev-latest
