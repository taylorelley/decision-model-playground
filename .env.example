# Copy to .env and fill in. These are read by the playground server (Vite dev/preview)
# only; they are never bundled into the browser code.

# Base URL of the decision model API (required), e.g. https://api.example.com
DECISION_BASE_URL=

# API key, sent upstream as "Authorization: Bearer <key>"
DECISION_API_KEY=

# Model preselected in the playground (optional; you can type any model name in the UI)
DECISION_MODEL=

# Paths on DECISION_BASE_URL for evaluation and model listing (optional)
# DECISION_ENDPOINT_PATH=/v1/systemone
# DECISION_MODELS_PATH=/v1/models

# TLS certificate verification for calls to DECISION_BASE_URL is disabled by default
# (works behind TLS-inspecting proxies / self-signed certs). Set to true to verify.
DECISION_VERIFY_TLS=false
